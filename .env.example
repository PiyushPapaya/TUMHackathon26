# Vorlage für Umgebungsvariablen. Kopieren nach ".env" und eigene Werte eintragen.
# ".env" wird NIE committed (steht in .gitignore). Hier stehen niemals echte Werte!
# Windows: Copy-Item .env.example .env    Mac: cp .env.example .env

# ─── OpenAI (jede Person ihren EIGENEN Key; Anleitung: docs/SETUP.md Schritt 7) ───
OPENAI_API_KEY=
# Modellname erst Samstag festlegen (Liste prüfen: siehe docs/wissen/OPENAI-UND-ENTIRE.md)
OPENAI_MODEL=
# Optional: günstigeres Modell für Massen-Extraktion und Tests
OPENAI_MODEL_KLEIN=

# ─── Backend (FastAPI) ───
# Erlaubte Frontend-Adressen für CORS, kommagetrennt
CORS_ORIGINS=http://localhost:3000
# true = Antworten aus demo/cache/ statt OpenAI (Demo ohne Netz, spart Credits)
DEMO_MODUS=false

# ─── Frontend (Next.js) ───
# Adresse des Backends. NEXT_PUBLIC_* landet im Browser, also NIE einen Key hier eintragen!
NEXT_PUBLIC_API_URL=http://localhost:8000
